{
    "name": "ireagolf",
    "version": "1.0.0",
    "description": "BETA TEST IREA app",
    "author": "U_chan <chanii1017@naver.com>",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder"
    },
    "build": {
        "appId": "com.irea.golf",
        "productName": "IREAGOLF",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "loginPage.html",
            "static/",
            "database/",
            "scripts/",
            "Dialog/"
        ],
        "win": {
            "icon": "static/icons/app-icon.ico",
            "target": "nsis",
            "signAndEditExecutable": true,
            "signtoolOptions": {
                "certificateFile": "C:\\irea-app-cert.pfx",
                "certificatePassword": "1q2w3e"
            }
        },
        "mac": {
            "icon": "static/icons/app-icon.icns",
            "target": [
                "dmg",
                "zip"
            ]
        },
        "linux": {
            "icon": "static/icons/app-icons.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": false,
            "runAfterFinish": false,
            "shortcutName": "IREAGOLF",
            "installerIcon": "static/icons/app-icon.ico",
            "uninstallerIcon": "static/icons/app-icon.ico"
        }
    },
    "dependencies": {
        "iconv-lite": "^0.6.3",
        "sqlite3": "^5.1.7",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "@electron/universal": "^2.0.1",
        "7zip-bin": "^5.2.0",
        "electron": "^33.2.1",
        "electron-build-service": "^1.0.7",
        "electron-builder": "^25.1.8",
        "electron-packager": "^17.1.2",
        "vite": "^6.0.5"
    }
}
